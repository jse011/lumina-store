{
  "rules": {
    "config": {
      ".read": false,
      ".write": false
    },
    "prueba": {
      ".read": true,
      ".write": true
    },
    "produccion": {
      "hologramActions": {
        ".read": true,
        ".write": false
      },
      "products": {
        ".read": true,
        ".write": false
      },
      "settings": {
        ".read": true,
        ".write": false
      },
      "testimonials": {
        ".read": true,
        ".write": false
      },
      "processSteps": {
        ".read": true,
        ".write": false
      },
      "navItems": {
        ".read": true,
        ".write": false
      },
      "gallery": {
        ".read": true,
        ".write": false
      },
      "code": {
        "$code": {
          ".read": true,
          "ownerEmail": {
            ".read": true,
            ".write": "auth != null && !data.exists()"
          },
          "credits": {
            ".read": true,
            ".write": false
          },
          "resources": {
            ".read": "auth != null",
            ".write": "auth != null && newData.parent().child('ownerEmail').val() === auth.token.email"
          }
        }
      },
      "users": {
        "$userId": {
          ".read": "auth != null && $userId === auth.uid",
          "credits": {
            ".write": "auth != null && $userId === auth.uid",
            ".validate": "
              (
                (data.exists() && newData.val() === data.val() + root.child('produccion/code').child(newData.parent().child('lastCodeRedeemed').val()).child('credits').val()) ||
                (!data.exists() && newData.val() === root.child('produccion/code').child(newData.parent().child('lastCodeRedeemed').val()).child('credits').val())
              ) &&
              newData.parent().child('codes').child(newData.parent().child('lastCodeRedeemed').val()).exists() &&
              !data.parent().child('codes').child(newData.parent().child('lastCodeRedeemed').val()).exists()
            "
          },
          "codes": {
            ".write": "auth != null && $userId === auth.uid",
            "$codeId": {
              ".validate": "!data.exists()",
              "creditsEarned": {
                ".validate": "newData.val() === root.child('produccion/code').child($codeId).child('credits').val()"
              }
            }
          },
          "lastCodeRedeemed": {
            ".write": "auth != null && $userId === auth.uid",
            ".validate": "root.child('produccion/code').child(newData.val()).exists()"
          },
          "holograms": {
            ".read": "auth != null && $userId === auth.uid",
            "$hologramId": {
              ".write": "
                auth != null && $userId === auth.uid && newData.exists() && 
                (
                  newData.child('deleted').val() !== true || 
                  data.child('status').val() === 'ready'
                )
              ",".validate": "
                newData.hasChildren(['name', 'type', 'status', 'creditsUsed', 'createdAt'
              ]) &&
                newData.child('name').isString() &&
                (newData.child('type').val() === 'persona' || newData.child('type').val() === 'mascota') &&
                (newData.child('status').val() === 'pending' || newData.child('status').val() === 'processing' || newData.child('status').val() === 'ready' || newData.child('status').val() === 'error') &&
                newData.child('creditsUsed').isNumber() &&
                newData.child('creditsUsed').val() >= 0 &&
                (!data.exists() || newData.child('createdAt').val() === data.child('createdAt').val())
              "
            }
          }
        }
      }
    }
  }
}